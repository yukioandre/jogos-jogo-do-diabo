{
  "name": "conta-cubos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && concurrently -k -n worker,vite -c magenta,cyan \"wrangler dev --port 8787\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/server/tsconfig.json",
    "check-shapes": "node scripts/check-shapes.ts",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "wrangler": "^4.160.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
